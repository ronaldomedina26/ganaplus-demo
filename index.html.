:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#eef5ff;background:#0b1425}*{box-sizing:border-box}body{margin:0}button,input{font:inherit}button{cursor:pointer}main{max-width:520px;min-height:100dvh;margin:auto;padding:22px 17px 98px;background:linear-gradient(155deg,#101f3a,#0b1425 65%)}.top{display:flex;justify-content:space-between;align-items:center}.brand{display:flex;gap:10px;align-items:center}.logo{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#20bd8c;font-size:24px}.muted{color:#a8bbd3}.tiny{font-size:12px}.tag{display:inline-block;border:1px solid #607595;border-radius:99px;padding:6px 10px;color:#c3d8f0;font-size:12px}.balance{margin:23px 0 25px;padding:22px;border-radius:20px;background:linear-gradient(130deg,#234e66,#1b3354);box-shadow:0 12px 24px #04132655}.amount{font-size:42px;font-weight:800;margin:7px 0}.accent{color:#64e3bb}.section{display:flex;align-items:center;justify-content:space-between;margin:20px 0 12px}.tasks{display:grid;grid-template-columns:1fr 1fr;gap:12px}.tile{border:1px solid #344961;background:#172841;border-radius:17px;padding:17px 13px;min-height:164px;display:flex;flex-direction:column;gap:9px}.emoji{font-size:26px}.tile strong{font-size:16px}.tile p{margin:0;color:#aabfd6;font-size:12px;flex:1}.green{color:#5ee3ae;font-size:13px;font-weight:750}.btn{background:#20bf8e;color:#062a22;border:0;border-radius:12px;padding:12px 16px;font-weight:800;width:100%;margin-top:9px}.btn:disabled{background:#455c6c;color:#bdcbd6;cursor:default}.ghost{border:1px solid #3b5571;background:transparent;color:#edf5ff;border-radius:12px;padding:11px}.panel{background:#172841;border:1px solid #304861;border-radius:17px;padding:17px;margin:14px 0}.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,100%);background:#0d1b30;border-top:1px solid #2f415b;display:flex;justify-content:space-around;padding:10px 8px max(12px,env(safe-area-inset-bottom))}.nav button{background:transparent;color:#a2b6cd;border:0;padding:6px 12px;font-size:12px}.nav button.active{color:#62e4b6}.nav span{display:block;font-size:23px;margin-bottom:3px}.hidden{display:none}.row{display:flex;justify-content:space-between;align-items:center;gap:8px}.hist{padding:12px 0;border-bottom:1px solid #2e425e}.hist:last-child{border:0}.warning{background:#3a3030;border:1px solid #7c5550;border-radius:12px;padding:13px;color:#f8d8cb;font-size:12px;line-height:1.5}.field{width:100%;background:#0d1a2c;color:#fff;border:1px solid #42627f;padding:12px;border-radius:10px;margin:8px 0}.heading{font-size:22px;font-weight:800;margin:24px 0 10px}.pill{border-radius:30px;background:#244b46;color:#89ecc9;padding:4px 8px;font-size:11px}.note{font-size:12px;line-height:1.6;color:#a8bbd3}a{color:#73d7f8}

.auth-cover{position:fixed;inset:0;z-index:20;overflow:auto;background:#0b1425;padding:20px 18px;display:flex;align-items:center;justify-content:center}.auth-box{width:min(440px,100%);background:#142640;border:1px solid #38506c;border-radius:22px;padding:24px 20px;box-shadow:0 18px 40px #050c18}.auth-box h1{margin:8px 0;font-size:28px}.auth-box p{line-height:1.5}.auth-box label{font-size:13px;color:#c4d3e5}.auth-switch{display:flex;gap:10px;margin:20px 0 10px}.auth-switch button{width:50%;padding:10px;border:1px solid #3b5571;border-radius:10px;background:#0d1a2c;color:#dde8fb}.auth-switch button.selected{background:#216b60;border-color:#20bf8e;color:white}.auth-feedback{font-size:13px;line-height:1.5;min-height:20px;color:#ffd7ae;margin-top:10px}.auth-cover.hidden{display:none}.auth-box .btn{margin-top:16px}.auth-help{background:transparent;border:0;color:#83d9f5;padding:14px 4px 2px}.account-mail{overflow-wrap:anywhere;color:#9be8cb;font-size:13px}body.logged-out .nav{display:none}
</style></head><body class="logged-out"><div id="auth-cover" class="auth-cover"><div class="auth-box"><div class="brand"><span class="logo">💸</span><div><h1>GanaPlus</h1><div class="tiny muted">Tu cuenta para acceder a la demo</div></div></div><div class="auth-switch"><button id="tab-signin" class="selected" type="button">Entrar</button><button id="tab-signup" type="button">Crear cuenta</button></div><form id="auth-form"><label for="auth-email">Correo electrónico</label><input class="field" id="auth-email" type="email" autocomplete="email" placeholder="tunombre@correo.com" required maxlength="254"><label for="auth-password">Contraseña (mínimo 6 caracteres)</label><input class="field" id="auth-password" type="password" autocomplete="current-password" minlength="6" placeholder="Tu contraseña" required><button type="submit" id="auth-submit" class="btn">Iniciar sesión</button></form><button type="button" id="forgot-password" class="auth-help">Olvidé mi contraseña</button><div id="auth-message" class="auth-feedback" role="status" aria-live="polite">Conectando con Firebase…</div><p class="note">Las cuentas son reales, pero las actividades, puntos y retiros siguen siendo exclusivamente de demostración. No se pagan recompensas.</p></div></div><main><header class="top"><div class="brand"><span class="logo">💸</span><div><strong style="font-size:22px">GanaPlus</strong><div class="tiny muted">Gana puntos haciendo actividades</div></div></div><span class="tag">VERSIÓN DEMO</span></header>
<section id="home"><div class="balance"><div class="muted tiny">Saldo de demostración</div><div class="amount" id="balance">0 puntos</div><div class="row"><span class="accent tiny" id="equivalent">Equivale a $0.00 ficticios</span><button class="ghost" onclick="navigate('wallet')">Ver billetera</button></div></div><div class="section"><strong>Actividades de prueba</strong><span class="pill">Sin dinero real</span></div><div class="tasks" id="tasks"></div><div class="panel"><strong>🎯 Tu objetivo</strong><p class="note">Completa las tareas de prueba y descubre cómo se registran las recompensas. Estas tareas no son ofertas reales ni generan ingresos.</p></div></section>
<section id="wallet" class="hidden"><div class="heading">💰 Mi billetera</div><div class="balance"><div class="tiny muted">Puntos de prueba disponibles</div><div class="amount" id="walletbalance">0</div><div class="muted tiny" id="walletdollars">Valor ficticio: $0.00</div></div><div class="panel"><strong>Simular un retiro</strong><p class="note">Mínimo de prueba: 500 puntos ($5 ficticios). Esta pantalla NO envía dinero ni solicita datos de pago.</p><button class="btn" id="withdraw" onclick="simulateWithdraw()">Simular retiro de 500 puntos</button></div><div class="section"><strong>Movimientos</strong></div><div class="panel" id="history"></div></section>
<section id="invite" class="hidden"><div class="heading">👥 Invitar amigos</div><div class="panel"><strong>Tu código de demostración</strong><div class="row" style="margin-top:14px"><span style="font-size:22px;font-weight:800;letter-spacing:1px">GANAPLUS</span><button class="ghost" onclick="copyCode()">Copiar</button></div><p class="note">Los bonos por referidos no están activos. En la versión real solo se pagarán por actividades válidas y financiadas.</p></div></section>
<section id="profile" class="hidden"><div class="heading">⚙️ Mi perfil</div><div class="panel"><strong>👤 Mi cuenta</strong><p id="account-email" class="account-mail">Cargando…</p><p class="note" id="verify-note"></p><button class="ghost" id="verify-button" style="width:100%;margin-bottom:10px" type="button">Enviar correo de verificación</button><button class="ghost" id="signout-button" style="width:100%" type="button">Cerrar sesión</button></div><div class="panel"><label for="alias">Nombre de prueba</label><input id="alias" class="field" placeholder="Escribe un apodo" maxlength="30"><button class="btn" onclick="saveAlias()">Guardar apodo</button><div class="note" id="greeting"></div></div><div class="warning"><strong>Importante:</strong> El registro y el inicio de sesión usan Firebase Authentication. Los puntos y movimientos de prueba se guardan solo en este navegador, separados por usuario; no se sincronizan entre dispositivos y pueden modificarse o perderse. No representan dinero ni son válidos para retiros. No ingreses datos financieros.</div><button class="ghost" style="width:100%;margin-top:17px" onclick="resetDemo()">Reiniciar demostración</button></section>
</main><nav class="nav"><button id="nav-home" class="active" onclick="navigate('home')"><span>🏠</span>Inicio</button><button id="nav-wallet" onclick="navigate('wallet')"><span>💰</span>Billetera</button><button id="nav-invite" onclick="navigate('invite')"><span>👥</span>Invitar</button><button id="nav-profile" onclick="navigate('profile')"><span>⚙️</span>Perfil</button></nav><script>
const tasks=[{id:'welcome',icon:'🎁',name:'Bienvenida',desc:'Conoce GanaPlus',points:100},{id:'survey',icon:'📝',name:'Encuesta demo',desc:'Completa una encuesta simulada',points:120},{id:'offer',icon:'🎮',name:'Oferta demo',desc:'Prueba una oferta ficticia',points:180},{id:'guide',icon:'📚',name:'Guía rápida',desc:'Aprende cómo funciona el saldo',points:100}];
let key='ganaplus-demo-inactivo';let data;try{data=JSON.parse(localStorage.getItem(key))||{}}catch(e){data={}};if(!data||typeof data!=='object')data={};data.points=Number.isFinite(data.points)?Math.max(0,data.points):0;data.done=Array.isArray(data.done)?data.done:[];data.history=Array.isArray(data.history)?data.history:[];
function persist(){localStorage.setItem(key,JSON.stringify(data))}function cash(n){return '$'+(n/100).toFixed(2)}function clean(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function render(){document.getElementById('balance').textContent=data.points+' puntos';document.getElementById('equivalent').textContent='Equivale a '+cash(data.points)+' ficticios';document.getElementById('walletbalance').textContent=data.points+' puntos';document.getElementById('walletdollars').textContent='Valor ficticio: '+cash(data.points);document.getElementById('withdraw').disabled=data.points<500;document.getElementById('tasks').innerHTML=tasks.map(t=>'<div class="tile"><div class="emoji">'+t.icon+'</div><strong>'+t.name+'</strong><p>'+t.desc+'</p><div class="green">+'+t.points+' puntos</div><button class="btn" '+(data.done.includes(t.id)?'disabled':'')+' onclick="completeTask(\''+t.id+'\')">'+(data.done.includes(t.id)?'Completada ✓':'Completar')+'</button></div>').join('');document.getElementById('history').innerHTML=data.history.length?data.history.slice().reverse().map(h=>'<div class="hist row"><div><strong>'+clean(h.label)+'</strong><div class="tiny muted">'+clean(h.date)+'</div></div><strong class="'+(h.change>0?'accent':'')+'">'+(h.change>0?'+':'')+h.change+'</strong></div>').join(''):'<p class="note">Todavía no tienes movimientos.</p>';document.getElementById('alias').value=data.alias||'';document.getElementById('greeting').textContent=data.alias?'Hola, '+data.alias+'. Tu apodo quedó guardado en este dispositivo.':''}
function completeTask(id){if(!window.gpSignedIn)return;if(data.done.includes(id))return;let t=tasks.find(t=>t.id===id);if(!t)return;data.done.push(id);data.points+=t.points;data.history.push({label:t.name,change:t.points,date:new Date().toLocaleDateString('es-US')});persist();render()}
function simulateWithdraw(){if(!window.gpSignedIn)return;if(data.points<500)return;data.points-=500;data.history.push({label:'Retiro simulado (sin pago real)',change:-500,date:new Date().toLocaleDateString('es-US')});persist();render();alert('¡Simulación completada! Se descontaron 500 puntos ficticios. No se realizó ningún pago real.')}
function navigate(id){['home','wallet','invite','profile'].forEach(x=>{document.getElementById(x).classList.toggle('hidden',x!==id);document.getElementById('nav-'+x).classList.toggle('active',x===id)});window.scrollTo(0,0)}function saveAlias(){data.alias=document.getElementById('alias').value.trim().slice(0,30);persist();render()}function resetDemo(){if(confirm('¿Borrar todos los puntos y movimientos de demostración?')){localStorage.removeItem(key);data={points:0,done:[],history:[]};render();navigate('home')}}async function copyCode(){try{await navigator.clipboard.writeText('GANAPLUS');alert('Código copiado')}catch(e){alert('Tu código es GANAPLUS')}}render();
</script>
<script type="module">
import {initializeApp} from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js';
import {getAuth,onAuthStateChanged,createUserWithEmailAndPassword,signInWithEmailAndPassword,sendPasswordResetEmail,sendEmailVerification,signOut} from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js';
const firebaseConfig={apiKey:'AIzaSyA-gPDzbuEc-aZNHclwBplCUb9HWeFnfNY',authDomain:'ganaplus-2cf5a.firebaseapp.com',projectId:'ganaplus-2cf5a',storageBucket:'ganaplus-2cf5a.firebasestorage.app',messagingSenderId:'179279295387',appId:'1:179279295387:web:e09aa1f62b67a5537b273e',measurementId:'G-XVEK9JZ4JQ'};
const overlay=document.getElementById('auth-cover'),msg=document.getElementById('auth-message'),emailInput=document.getElementById('auth-email'),passInput=document.getElementById('auth-password'),submit=document.getElementById('auth-submit');
let mode='signin',auth;
function message(s){msg.textContent=s}
function errorMessage(e){const errors={'auth/email-already-in-use':'Ese correo ya tiene una cuenta. Prueba iniciar sesión.','auth/invalid-email':'Revisa la dirección de correo.','auth/weak-password':'Elige una contraseña más segura.','auth/invalid-credential':'El correo o la contraseña no son correctos.','auth/too-many-requests':'Hay demasiados intentos. Prueba más tarde.','auth/network-request-failed':'No hay conexión. Revisa internet.','auth/operation-not-allowed':'Activa correo y contraseña en Firebase Authentication.','auth/unauthorized-domain':'Autoriza ronaldomedina26.github.io en Firebase Authentication > Configuración > Dominios autorizados.'};return errors[e?.code]||'No se pudo completar la operación. '+(e?.code||'Inténtalo de nuevo.')}
function setMode(m){mode=m;document.getElementById('tab-signin').classList.toggle('selected',m==='signin');document.getElementById('tab-signup').classList.toggle('selected',m==='signup');submit.textContent=m==='signin'?'Iniciar sesión':'Crear cuenta';passInput.autocomplete=m==='signin'?'current-password':'new-password';document.getElementById('forgot-password').style.display=m==='signin'?'block':'none';message('')}
document.getElementById('tab-signin').onclick=()=>setMode('signin');document.getElementById('tab-signup').onclick=()=>setMode('signup');
function setSession(user){window.gpSignedIn=Boolean(user);overlay.classList.toggle('hidden',!!user);document.body.classList.toggle('logged-out',!user);if(user){key='ganaplus-demo-v2-'+user.uid;try{data=JSON.parse(localStorage.getItem(key))||{}}catch{data={}};data.points=Number.isFinite(data.points)?Math.max(0,data.points):0;data.done=Array.isArray(data.done)?data.done:[];data.history=Array.isArray(data.history)?data.history:[];document.getElementById('account-email').textContent=user.email||'Cuenta activa';document.getElementById('verify-note').textContent=user.emailVerified?'Correo verificado ✅':'Tu correo aún no está verificado. Revisa tu bandeja de entrada o solicita un mensaje.';document.getElementById('verify-button').style.display=user.emailVerified?'none':'block';render();navigate('home')}else{key='ganaplus-demo-inactivo';data={points:0,done:[],history:[]};message('Inicia sesión o crea tu cuenta.')}}
try{auth=getAuth(initializeApp(firebaseConfig));onAuthStateChanged(auth,setSession,e=>message(errorMessage(e)))}catch(e){message('No se pudo iniciar Firebase. Revisa la conexión.')}
document.getElementById('auth-form').addEventListener('submit',async e=>{e.preventDefault();if(!auth)return message('Firebase todavía no está disponible.');const email=emailInput.value.trim(),password=passInput.value;submit.disabled=true;message('Procesando…');try{if(mode==='signup'){const result=await createUserWithEmailAndPassword(auth,email,password);try{await sendEmailVerification(result.user);message('Cuenta creada. Revisa tu correo para verificarla.')}catch(err){message('Cuenta creada, pero no se pudo enviar la verificación: '+errorMessage(err))}}else{await signInWithEmailAndPassword(auth,email,password);message('Sesión iniciada.')}}catch(err){message(errorMessage(err))}finally{submit.disabled=false;passInput.value=''}});
document.getElementById('forgot-password').onclick=async()=>{if(!auth)return;const mail=emailInput.value.trim();if(!mail)return message('Escribe primero tu correo electrónico.');try{await sendPasswordResetEmail(auth,mail);message('Si existe una cuenta con ese correo, recibirás instrucciones para restablecer la contraseña.')}catch(e){message(errorMessage(e))}};
document.getElementById('signout-button').onclick=async()=>{if(auth)await signOut(auth)};
document.getElementById('verify-button').onclick=async()=>{try{if(auth?.currentUser){await sendEmailVerification(auth.currentUser);alert('Revisa tu correo para verificar la cuenta.')}}catch(e){alert(errorMessage(e))}};
</script></body></html>
